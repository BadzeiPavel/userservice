<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet id="003-add-indexes" author="pablo">
    <!-- Indexes for users table -->
    <createIndex indexName="idx_users_email"
      tableName="users"
      unique="true">
      <column name="email"/>
    </createIndex>

    <createIndex indexName="idx_users_name_surname"
      tableName="users">
      <column name="name"/>
      <column name="surname"/>
    </createIndex>

    <createIndex indexName="idx_users_birth_date"
      tableName="users">
      <column name="birth_date"/>
    </createIndex>

    <!-- Indexes for payment_cards table -->
    <createIndex indexName="idx_payment_cards_user_id"
      tableName="payment_cards">
      <column name="user_id"/>
    </createIndex>

    <createIndex indexName="idx_payment_cards_number"
      tableName="payment_cards"
      unique="true">
      <column name="number"/>
    </createIndex>

    <createIndex indexName="idx_payment_cards_expiration_date"
      tableName="payment_cards">
      <column name="expiration_date"/>
    </createIndex>

    <createIndex indexName="idx_payment_cards_holder"
      tableName="payment_cards">
      <column name="holder"/>
    </createIndex>

    <comment>Add performance indexes for better query performance</comment>
  </changeSet>

</databaseChangeLog>